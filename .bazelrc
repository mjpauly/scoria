build --incompatible_enable_cc_toolchain_resolution

build:linux_amd64 --platforms @zig_sdk//platform:linux_amd64
build:linux_amd64 --extra_toolchains @zig_sdk//toolchain:linux_amd64_gnu.2.34

build:app_release --ios_multi_cpus=arm64 --device_debug_entitlements=false --define profile=distribution -c opt
