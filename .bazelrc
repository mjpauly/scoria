# for bazel run --config=rustfmt @rules_rust//:rustfmt
run:rustfmt --@rules_rust//:rustfmt.toml=//:rustfmt.toml

# For hermetic_cc_toolchain
common --enable_platform_specific_config
build:linux --sandbox_add_mount_pair=/tmp
build:macos --sandbox_add_mount_pair=/var/tmp
build:windows --sandbox_add_mount_pair=C:\Temp

build --incompatible_enable_cc_toolchain_resolution

# Flag ordering: platform type, optimizations, distribution config.
# See the comment in the BUILD file about how these flags work and what they do.

build:ios \
    --ios_multi_cpus=arm64 \

build:ios_opt \
    --ios_multi_cpus=arm64 \
    \
    -c opt \
    --objc_enable_binary_stripping \

build:ios_release \
    --ios_multi_cpus=arm64 \
    \
    -c opt \
    --objc_enable_binary_stripping \
    \
    --//:profile=distribution \
    --device_debug_entitlements=false \


build:android \
    --//:platform_config=android \
    --fat_apk_cpu=arm64-v8a \

build:android_opt \
    --//:platform_config=android \
    --fat_apk_cpu=arm64-v8a \
    \
    -c opt \

build:android_release \
    --//:platform_config=android \
    --fat_apk_cpu=arm64-v8a \
    \
    -c opt \
    \
    --//:profile=distribution \
